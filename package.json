{
  "name": "botpassport",
  "version": "0.1.0",
  "description": "Allowlist AI crawlers and search engine bots (GPTBot, ClaudeBot, PerplexityBot, Googlebot, bingbot) by their official IP ranges, for CrowdSec, nginx, Caddy and nftables.",
  "type": "module",
  "exports": "./src/index.js",
  "bin": {
    "botpassport": "src/cli.js"
  },
  "files": [
    "src",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/"
  },
  "keywords": [
    "ai-crawlers",
    "crawler-ip-ranges",
    "bot-allowlist",
    "allowlist",
    "whitelist",
    "crowdsec",
    "crowdsec-allowlist",
    "firewall",
    "nginx",
    "caddy",
    "nftables",
    "gptbot",
    "chatgpt-user",
    "oai-searchbot",
    "claudebot",
    "perplexitybot",
    "googlebot",
    "bingbot",
    "applebot",
    "amazonbot",
    "ccbot",
    "verified-bots",
    "good-bots",
    "geo",
    "generative-engine-optimization",
    "seo",
    "ai-search",
    "llm-crawlers",
    "reverse-dns",
    "ip-ranges"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilanoh/botpassport.git"
  },
  "homepage": "https://github.com/ilanoh/botpassport#readme",
